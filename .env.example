# Use a long random value in production. Never commit the real value.
AOTU_SESSION_SECRET=replace-with-at-least-32-random-characters

# Keep this server-only. Obtain it from the authorized APK analysis.
AOTU_MEDIA_SALT=replace-with-the-server-side-media-signing-value

# Optional overrides. The defaults target the official service.
AOTU_API_BASE_URL=https://api.aotuyuzhou.com/api/
AOTU_H5_HOME_URL=https://m.aotuyuzhou.com/api/v1.h5/home
AOTU_APP_USER_AGENT=AppVersion:1.7.43;Desktop#DeviceModel:WebPlayer#AndroidVersion:13#APILevel:33#
